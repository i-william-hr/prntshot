				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/bash
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:$PATH"

notify() {
	local title="$1"
	local msg="$2"
	if command -v terminal-notifier &gt;/dev/null 2&gt;&amp;1; then
		terminal-notifier -title "$title" -message "$msg" -sender com.apple.photos 2&gt;/dev/null || \
		osascript -e "display notification \"$msg\" with title \"$title\""
	elif [ -x "/opt/homebrew/bin/terminal-notifier" ]; then
		/opt/homebrew/bin/terminal-notifier -title "$title" -message "$msg" -sender com.apple.photos 2&gt;/dev/null || \
		osascript -e "display notification \"$msg\" with title \"$title\""
	elif [ -x "/usr/local/bin/terminal-notifier" ]; then
		/usr/local/bin/terminal-notifier -title "$title" -message "$msg" -sender com.apple.photos 2&gt;/dev/null || \
		osascript -e "display notification \"$msg\" with title \"$title\""
	else
		osascript -e "display notification \"$msg\" with title \"$title\""
	fi
}

# Resolve ulf path
if command -v ulf &gt;/dev/null 2&gt;&amp;1; then
	ULF_BIN="$(command -v ulf)"
elif [ -x "/opt/homebrew/bin/ulf" ]; then
	ULF_BIN="/opt/homebrew/bin/ulf"
elif [ -x "/usr/local/bin/ulf" ]; then
	ULF_BIN="/usr/local/bin/ulf"
else
	ULF_BIN="ulf"
fi

scrot_dir="${HOME}/.screenshot"
mkdir -p "$scrot_dir"
tmpname="tmpscrot.$(head -c 1024 /dev/urandom | md5).png"
scrot_path="${scrot_dir}/${tmpname}"

SCROTARGS="-i -x -T 0 -r"
screencapture $SCROTARGS "$scrot_path" 2&gt;/dev/null
scrot_exit=$?

if [ $scrot_exit -ne 0 ] || [ ! -f "$scrot_path" ]; then
	# User cancelled selection (ESC) or screencapture failed
	exit 0
fi

notify "Screenshot Finished" "Screenshot captured - Uploading..."

result=$("$ULF_BIN" -c -i "$scrot_path")
status=$?

if [ $status -eq 0 ] &amp;&amp; [ -n "$result" ]; then
	echo -n "$result" | pbcopy
	notify "Screenshot Uploaded" "Screenshot uploaded - URL copied"
else
	notify "Upload Failed" "Failed to upload screenshot"
fi

rm -f "$scrot_path"</string>
					<key>CheckedForUserDefaultShell</key>
